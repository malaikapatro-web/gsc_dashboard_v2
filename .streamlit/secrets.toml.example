# Template only. Never put real values in this file or commit them.
# On Streamlit Community Cloud: App settings > Secrets, paste the filled-in version of this.
# Locally: copy to .streamlit/secrets.toml (git-ignored) and fill in.

# Password viewers must enter before the dashboard opens. Keep this line ABOVE the [snowflake] table.
# If it is missing the app stays locked. Use a long, unique value.
app_password = "<choose a long random password>"

[snowflake]
account = "<orgname>-<account_name>"   # from your Snowsight URL: app.snowflake.com/<orgname>/<account_name>/
user = "<snowflake_user>"
role = "<role>"
warehouse = "<warehouse>"
scratch_schema = "<DB>.<SCHEMA>"       # optional; role needs CREATE TEMPORARY TABLE here. Default MARKETING_BRONZE_DB.STAGING

# Key-pair auth. On Community Cloud paste the private key (PEM text) here:
private_key = """
-----BEGIN PRIVATE KEY-----
<paste key body here>
-----END PRIVATE KEY-----
"""
# private_key_passphrase = "<only if the key is encrypted>"

# Local development alternative to private_key (path to a key file on your machine):
# private_key_path = 'C:\path\to\rsa_key.p8'
